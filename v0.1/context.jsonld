{
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "schema": "https://schema.org/",
    "ecosystem": "https://standard.techtable.ro/v0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "Organization": "schema:Organization",
    "Person": "schema:Person",
    "Event": "schema:Event",
    "Place": "schema:Place",
    "GeoCoordinates": "schema:GeoCoordinates",
    "Project": "ecosystem:Project",

    "name": { "@id": "schema:name", "@container": "@language" },
    "description": { "@id": "schema:description", "@container": "@language" },
    "address": { "@id": "schema:address", "@container": "@language" },
    "url": { "@id": "schema:url", "@type": "@id" },
    "image": { "@id": "schema:image", "@type": "@id" },
    "logo": { "@id": "schema:logo", "@type": "@id" },
    "email": "schema:email",
    "sameAs": { "@id": "schema:sameAs", "@type": "@id", "@container": "@set" },
    "affiliation": { "@id": "schema:affiliation", "@type": "@id" },
    "organizer": { "@id": "schema:organizer", "@type": "@id" },
    "location": { "@id": "schema:location", "@type": "@id" },
    "geo": "schema:geo",
    "latitude": { "@id": "schema:latitude", "@type": "xsd:decimal" },
    "longitude": { "@id": "schema:longitude", "@type": "xsd:decimal" },
    "addressLocality": "schema:addressLocality",
    "addressCountry": "schema:addressCountry",
    "startDate": { "@id": "schema:startDate", "@type": "xsd:dateTime" },
    "endDate": { "@id": "schema:endDate", "@type": "xsd:dateTime" },
    "maximumAttendeeCapacity": { "@id": "schema:maximumAttendeeCapacity", "@type": "xsd:integer" },
    "isAccessibleForFree": { "@id": "schema:isAccessibleForFree", "@type": "xsd:boolean" },
    "performer": { "@id": "schema:performer", "@type": "@id", "@container": "@set" },
    "eventStatus": { "@id": "schema:eventStatus", "@type": "@vocab" },

    "EventScheduled": "schema:EventScheduled",
    "EventCancelled": "schema:EventCancelled",
    "EventPostponed": "schema:EventPostponed",
    "EventRescheduled": "schema:EventRescheduled",
    "EventMovedOnline": "schema:EventMovedOnline",


    "domain": { "@id": "ecosystem:domain", "@type": "@vocab" },
    "tags": { "@id": "schema:keywords", "@container": "@set" },
    "role": { "@id": "ecosystem:role", "@container": "@language" },
    "short": { "@id": "ecosystem:short", "@container": "@language" },
    "category": "ecosystem:category",
    "project": { "@id": "ecosystem:project", "@type": "@id" },
    "leadOrganisation": { "@id": "ecosystem:leadOrganisation", "@type": "@id" },
    "partners": { "@id": "ecosystem:partners", "@container": "@language" },
    "status": { "@id": "ecosystem:status", "@type": "@vocab" },
    "isVirtual": { "@id": "ecosystem:isVirtual", "@type": "xsd:boolean" },
    "ticketsUrl": { "@id": "ecosystem:ticketsUrl", "@type": "@id" },
    "photosUrl": { "@id": "ecosystem:photosUrl", "@type": "@id" },
    "speakersCount": { "@id": "ecosystem:speakersCount", "@type": "xsd:integer" },
    "realParticipants": { "@id": "ecosystem:realParticipants", "@type": "xsd:integer" },
    "startDateOnly": { "@id": "ecosystem:startDateOnly", "@type": "xsd:date" },
    "endDateOnly": { "@id": "ecosystem:endDateOnly", "@type": "xsd:date" },

    "tech": "ecosystem:tech",
    "entrepreneurial": "ecosystem:entrepreneurial",
    "civic": "ecosystem:civic",
    "creative": "ecosystem:creative",

    "planning": "ecosystem:planning",
    "active": "ecosystem:active",
    "completed": "ecosystem:completed",
    "paused": "ecosystem:paused"
  }
}
