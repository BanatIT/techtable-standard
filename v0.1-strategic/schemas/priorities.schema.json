{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standard.techtable.ro/v0.1-strategic/schemas/priorities.schema.json",
  "title": "Priorities",
  "description": "TechTable Standard v0.1-strategic: Priorities (annual strategic priorities for an ecosystem)",
  "type": "object",
  "required": ["@context", "@type", "@id", "inEcosystem", "year", "items"],
  "properties": {
    "@context": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "object" }
      ]
    },
    "@type": { "const": "Priorities" },
    "@id": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "inEcosystem": { "$ref": "#/$defs/idRef" },
    "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
    "dateAssessed": { "type": "string", "format": "date" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/priorityItem" }
    },
    "notes": { "$ref": "#/$defs/i18nString" }
  },
  "additionalProperties": true,
  "$defs": {
    "i18nString": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "patternProperties": {
            "^[a-z]{2,3}(-[A-Za-z0-9]{1,8})*$": { "type": "string" }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      ]
    },
    "idRef": {
      "type": "object",
      "required": ["@id"],
      "properties": {
        "@id": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "priorityItem": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/i18nString" },
        "description": { "$ref": "#/$defs/i18nString" },
        "successMetric": { "$ref": "#/$defs/i18nString" },
        "relatedProjects": {
          "type": "array",
          "items": { "$ref": "#/$defs/idRef" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  }
}
